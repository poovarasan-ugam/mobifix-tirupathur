rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'poovarasanking335@gmail.com',
          'msptraderstpt@gmail.com'
        ];
    }

    // Public product catalog — anyone can browse, only allowlisted admins can edit.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Repair leads — anyone can submit a booking, only allowlisted admins can read/manage.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders — anyone can create during checkout, only allowlisted admins can read/manage.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
