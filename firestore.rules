rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'owner';
    }

    // Admin directory — every admin can read their own record (to learn their
    // role), but only the owner can list everyone or add/remove admins.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // Public product catalog — anyone can browse, any admin can edit.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Which shop a product was sourced from — internal, not public, but not
    // money either, so any admin can see/manage it.
    match /productShops/{productId} {
      allow read, write: if isAdmin();
    }

    // Shop cost / margin — owner-only, never exposed to sub-admins or the public.
    match /productCosts/{productId} {
      allow read, write: if isOwner();
    }

    // Supplier directory.
    match /shops/{shopId} {
      allow read, write: if isAdmin();
    }

    // Repair leads — anyone can submit a booking, any admin can read/manage.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders — anyone can create during checkout, any admin can read/manage.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
