rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public product catalog — anyone can browse, only signed-in admin can edit.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Repair leads — anyone can submit a booking, only signed-in admin can read/manage.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Orders — anyone can create during checkout, only signed-in admin can read/manage.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
